# ============================================================
#  bot.js — Environment Configuration
#  Copy to .env and fill in. Never commit your real .env.
#  Comments are on their own lines (safer than inline comments).
# ============================================================


# ############################################################
#  PART 1 — REQUIRED TO START
#  The bot exits immediately if any of these are missing/invalid.
# ############################################################

# BotFather token
TELEGRAM_TOKEN=

# Your numeric Telegram user ID (admin)
ADMIN_ID=

# MongoDB Atlas connection string
MONGODB_CONNECT=

# Public HTTPS URL of this deployment (used for the webhook), e.g. https://your-app.onrender.com
RENDER_URL=


# ############################################################
#  PART 2 — AI PROVIDER API KEYS
#  Set at least ONE, otherwise users get "No AI model is available".
#  Model NAMES are no longer set here — add them in Telegram:
#    /addmodel <id> <provider> <free|pro> <vision yes|no> <model-name> [label]
# ############################################################

GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Optional extra providers (OpenAI-compatible) — fill only the ones you use
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=


# ############################################################
#  PART 3 — OPTIONAL (defaults shown, safe to leave as is)
# ############################################################

# ── Server ──────────────────────────────────────────────────
# Render sets this automatically
PORT=3000

# ── Force join (leave blank to disable) ─────────────────────
# e.g. @yourchannel (bot must be admin there). Also shown as the contact for approval.
FORCE_JOIN_CHANNEL=

# ── Website pages (/, /privacy, /terms) ─────────────────────
BOT_DISPLAY_NAME=
BOT_USERNAME=
SUPPORT_USERNAME=

# ── Daily limits (per user) ─────────────────────────────────
# Total AI requests per day (chat + doc + image)
DAILY_REQUEST_LIMIT=50
# Total tokens per day
DAILY_TOKEN_LIMIT=50000
# Document uploads per day
LIMIT_DOC_ANALYSIS=5
# Image analyses per day
LIMIT_IMG_ANALYSIS=10
# Requests per day on models added with tier "pro"
LIMIT_PRO_MODEL=10

# ── Reply behaviour ─────────────────────────────────────────
# Max tokens per AI reply. Thinking/reasoning models can use this up before answering,
# so raise it (e.g. 4096) if you see "empty answer" errors.
MAX_REPLY_TOKENS=1024
# Overrides the default "short, concise answer" instruction (leave blank to use the default)
STYLE_PROMPT=
# Max characters of a document sent to the AI
DOC_CHAR_LIMIT=10000
# Max upload size in MB
MAX_FILE_MB=10
# Timeout for AI/API calls in ms. Slower/thinking models may need 60000+.
API_TIMEOUT_MS=30000

# ── History / storage ───────────────────────────────────────
# Max chars stored per history message
MAX_HISTORY_CHARS=500
# Messages of context sent to the AI
HISTORY_MESSAGES=10
# Messages kept per chat in the DB
DB_MSG_LIMIT=20
# Auto-delete chat history after N days
CHAT_HISTORY_TTL_DAYS=30
# Delete inactive (unapproved, unbanned) users after N days
INACTIVE_USER_DELETE_DAYS=90

# ── Rate limits (despite the name, RATE_LIMIT_MS is in SECONDS) ──
# Seconds between normal text messages
RATE_LIMIT_MS=3
# Seconds between document/photo uploads
LIMIT_MEDIA_COOLDOWN=10

# ── Concurrency ─────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=20
REQUEST_QUEUE_LIMIT=100

# ── Caching / approvals ─────────────────────────────────────
MEMORY_CACHE_CLEAR_MINUTES=30
MEMBERSHIP_CACHE_MINUTES=10
# Default hours of access when you run /approve <id> without hours
APPROVAL_EXPIRY_HOURS=24
APPROVAL_CACHE_SECONDS=60
