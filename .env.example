# ============================================================
#  bot.js — Environment Configuration
# ============================================================

# ──For Telegram Bot Website────────────────────────────────────────────────
BOT_DISPLAY_NAME=
BOT_USERNAME=
SUPPORT_USERNAME=

# ── Telegram ────────────────────────────────────────────────
TELEGRAM_TOKEN=                     # BotFather token (required)
ADMIN_ID=                           # Your numeric Telegram user ID (required)
FORCE_JOIN_CHANNEL=                 # e.g. @yourchannel — leave blank to disable force-join

# ── Server / Hosting ────────────────────────────────────────
RENDER_URL=                         # Public HTTPS URL of this deployment (for webhook)
PORT=

# ── Database ────────────────────────────────────────────────
MONGODB_CONNECT=                    # MongoDB Atlas connection string (required)

# ── AI Provider API Keys ────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# ── AI Models ───────────────────────────────────────────────
# Four selectable Gemini models
GEMINI_MODEL_1=gemini-2.0-flash
GEMINI_MODEL_2=gemini-2.0-flash-lite
GEMINI_MODEL_3=gemini-1.5-flash
GEMINI_MODEL_4=gemini-1.5-pro

# One selectable OpenAI model
OPENAI_MODEL_1=gpt-4o-mini

# One selectable Claude model
CLAUDE_MODEL_1=claude-3-5-haiku-20241022

# ── "Pro" model slot (rate-limited separately via LIMIT_PRO_MODEL) ──
# Point this at ANY provider + model — it does not have to be Gemini.
# PRO_PROVIDER must be one of: gemini | openai | claude
# PRO_MODEL_NAME is the exact model string for that provider.
PRO_PROVIDER=gemini
PRO_MODEL_NAME=gemini-1.5-pro
# Examples:
#   PRO_PROVIDER=openai
#   PRO_MODEL_NAME=gpt-4o
# ---
#   PRO_PROVIDER=claude
#   PRO_MODEL_NAME=claude-3-5-sonnet-20241022

# ── Daily Limits ────────────────────────────────────────────
DAILY_REQUEST_LIMIT=50              # Total AI requests/user/day (chat + doc + image)
DAILY_TOKEN_LIMIT=50000             # Total tokens/user/day
MAX_REPLY_TOKENS=1024               # Max tokens per AI reply

LIMIT_DOC_ANALYSIS=5                # Document uploads/user/day
LIMIT_IMG_ANALYSIS=10               # Image analyses/user/day
LIMIT_PRO_MODEL=10                  # Pro-model requests/user/day

# ── History / Storage ───────────────────────────────────────
DOC_CHAR_LIMIT=10000                # Max chars of a document sent to the AI
MAX_HISTORY_CHARS=500               # Max chars stored per history message
HISTORY_MESSAGES=10                 # Messages of context sent to the AI
DB_MSG_LIMIT=20                     # Messages kept per chat in DB
CHAT_HISTORY_TTL_DAYS=30            # Auto-delete chat history after N days
INACTIVE_USER_DELETE_DAYS=90        # (if used by a cleanup job) inactive user retention

# ── Rate Limits (seconds unless noted) ───────────────────────
RATE_LIMIT_MS=3                     # Seconds between normal text messages
COMMAND_LIMIT_MS=5                  # Seconds between command invocations
LIMIT_MEDIA_COOLDOWN=10             # Seconds between document/photo uploads
MAX_FILE_MB=10                      # Max upload size (MB)

# ── Concurrency ─────────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=20
REQUEST_QUEUE_LIMIT=100

# ── Caching ─────────────────────────────────────────────────
MEMORY_CACHE_CLEAR_MINUTES=30
MEMBERSHIP_CACHE_MINUTES=10
APPROVAL_EXPIRY_HOURS=24
APPROVAL_CACHE_SECONDS=60

# ── Misc ────────────────────────────────────────────────────
API_TIMEOUT_MS=30000                # Timeout for external API calls (ms)
